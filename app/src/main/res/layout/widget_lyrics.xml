<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_lyrics_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp"
    android:theme="@style/Theme.Widget.echomusic">

    <!-- Top Row: Song Info + Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Album Art -->
        <ImageView
            android:id="@+id/widget_lyrics_album_art"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/album_art" />

        <!-- Title & Artist -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_lyrics_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/not_playing"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_primary"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_lyrics_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tap_to_play"
                android:textSize="12sp"
                android:textColor="@color/widget_text_secondary"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <!-- Playback Controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_lyrics_prev"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_skip_previous"
                android:contentDescription="@string/previous" />

            <ImageView
                android:id="@+id/widget_lyrics_play_pause"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_play"
                android:contentDescription="@string/play_pause" />

            <ImageView
                android:id="@+id/widget_lyrics_next"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_skip_next"
                android:contentDescription="@string/next" />
        </LinearLayout>
    </LinearLayout>

    <!-- Divider Line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="#22FFFFFF" />

    <!-- Lyrics Section -->
    <LinearLayout
        android:id="@+id/widget_lyrics_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <!-- Active Synced Line -->
        <TextView
            android:id="@+id/widget_lyrics_current_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_lyrics_available"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.15" />

        <!-- Next Upcoming Line -->
        <TextView
            android:id="@+id/widget_lyrics_next_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:textColor="@color/widget_text_secondary"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="6dp" />
    </LinearLayout>

</LinearLayout>
